PROJECT_NAME=Step
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://keystone:keystone@localhost:5432/keystone
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_USERS=change-me-users-secret
JWT_SECRET_END_USERS=change-me-end-users-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30

OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

APP_TOKEN_BYTES=32
APP_TOKEN_PREFIX=app_live_

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@keystone.dev
SMTP_USE_TLS=true
