PROJECT_NAME=Step
ENVIRONMENT=development

# Optionnel — sert à construire le lien de reset password des Users (dev/admin).
# Vide = le forgot-password renvoie le token brut au lieu d'un lien.
FRONTEND_URL=

DATABASE_URL=postgresql+asyncpg://step:step@localhost:5432/step
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_USERS=change-me-users-secret
JWT_SECRET_END_USERS=change-me-end-users-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30

OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

APP_TOKEN_BYTES=32
APP_TOKEN_PREFIX=app_live_

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@step.dev
SMTP_USE_TLS=true
