PROJECT_NAME=Step
ENVIRONMENT=development

# Optional — used to build the password reset link for Users (dev/admin).
# Empty = forgot-password returns the raw token instead of a link.
FRONTEND_URL=

# CORS-allowed origins, comma-separated (empty = no origin allowed)
ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://step:step@localhost:5432/step
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_USERS=change-me-users-secret
JWT_SECRET_END_USERS=change-me-end-users-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30

OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

APP_TOKEN_BYTES=32
APP_TOKEN_PREFIX=app_live_

# Transactional email via the Brevo HTTP API (https://app.brevo.com -> SMTP & API -> API Keys).
# Empty BREVO_API_KEY = dev mode: the OTP / reset link is printed to the logs instead of being sent.
BREVO_API_KEY=
EMAIL_FROM=no-reply@step.dev
EMAIL_FROM_NAME=Step
